# Copy to servers.env and `source` it before running the distributed tools.
# Nothing here is stored in the repository.
#
# The published experiments ran on three machines: the main panel, the
# heterogeneity panel, the seed-extension panel and the upstream baselines all
# ran on one Intel Xeon 8352V host, while the role panel and the scaling panel
# ran on two AMD EPYC 9654 hosts.  Hardware uniformity is enforced per
# experiment by the `hardware_uniformity` gate.
export MPCF_SRV1_HOST=srv1.example.net
export MPCF_SRV1_PORT=22
export SSH_PASSWORD_SRV1=changeme

export MPCF_SRV2_HOST=srv2.example.net
export MPCF_SRV2_PORT=22
export SSH_PASSWORD_SRV2=changeme

export MPCF_SRV3_HOST=srv3.example.net
export MPCF_SRV3_PORT=22
export SSH_PASSWORD_SRV3=changeme
