# Files shipped in a source distribution of this repository.
#
# The published tree is a subset of the workspace it was built from: the
# historical protocol notes it references are not part of the release, so this
# manifest lists what is actually here rather than what the workspace had.
include README.md
include LICENSE
include CITATION.cff
include pyproject.toml
include requirements.txt
include requirements-server-py310.txt

recursive-include docs *.md
recursive-include revision *.md *.py *.sh
recursive-include scripts *.py *.sh
recursive-include tests *.py
